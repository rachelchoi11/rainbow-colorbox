<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>악보 쇼핑몰</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />
    <style>
        .swiper-container {
            width: 100%;
            padding-top: 50px;
            padding-bottom: 50px;
        }
        .swiper-slide {
            background-position: center;
            background-size: cover;
            width: 300px;
            height: 400px;
        }
        .sheet-music-item {
            text-align: center;
        }
        .sheet-music-item img {
            max-width: 100%;
            height: auto;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1 class="text-center my-4">악보 쇼핑몰</h1>
        
        <div class="menu text-center mb-4">
            <button class="btn btn-primary me-2" onclick="showShopPage()">쇼핑</button>
            <button class="btn btn-secondary" onclick="showUploadPage()">악보 업로드</button>
        </div>

        <div id="shopPage">
            <div class="swiper-container">
                <div class="swiper-wrapper" id="sheetMusicList"></div>
                <div class="swiper-pagination"></div>
            </div>
        </div>

        <div id="uploadPage" style="display:none;">
            <h2 class="mb-3">새 악보 추가</h2>
            <form id="addSheetMusicForm">
                <div class="mb-3">
                    <input type="text" class="form-control" id="title" placeholder="제목" required>
                </div>
                <div class="mb-3">
                    <textarea class="form-control" id="description" placeholder="설명"></textarea>
                </div>
                <div class="mb-3">
                    <input type="number" class="form-control" id="price" placeholder="가격" required>
                </div>
                <div class="mb-3">
                    <input type="number" class="form-control" id="discount" placeholder="할인률 (%)" min="0" max="100">
                </div>
                <div class="mb-3">
                    <input type="file" class="form-control" id="image" accept="image/*" required>
                </div>
                <div class="mb-3">
                    <input type="file" class="form-control" id="pdf" accept=".pdf" required>
                </div>
                <button type="submit" class="btn btn-primary">추가</button>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
    <script>
        let sheetMusicData = [];

        function displaySheetMusic() {
            const sheetMusicList = document.getElementById('sheetMusicList');
            sheetMusicList.innerHTML = '';
            sheetMusicData.forEach(sheet => {
                const sheetElement = document.createElement('div');
                sheetElement.className = 'swiper-slide';
                sheetElement.innerHTML = `
                    <div class="sheet-music-item">
                        <img src="${sheet.image}" alt="${sheet.title}">
                        <h3>${sheet.title}</h3>
                        <p>가격: ${sheet.price}원</p>
                        <button class="btn btn-primary" onclick="buySheetMusic(${sheet.id})">구매</button>
                    </div>
                `;
                sheetMusicList.appendChild(sheetElement);
            });

            // Swiper 초기화
            new Swiper('.swiper-container', {
                effect: 'coverflow',
                grabCursor: true,
                centeredSlides: true,
                slidesPerView: 'auto',
                coverflowEffect: {
                    rotate: 50,
                    stretch: 0,
                    depth: 100,
                    modifier: 1,
                    slideShadows: true,
                },
                pagination: {
                    el: '.swiper-pagination',
                },
            });
        }

        function showShopPage() {
            document.getElementById('shopPage').style.display = 'block';
            document.getElementById('uploadPage').style.display = 'none';
        }

        function showUploadPage() {
            document.getElementById('shopPage').style.display = 'none';
            document.getElementById('uploadPage').style.display = 'block';
        }

        document.getElementById('addSheetMusicForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const title = document.getElementById('title').value;
            const price = document.getElementById('price').value;
            const image = document.getElementById('image').files[0];
            const sheetMusic = document.getElementById('sheetMusic').files[0];

            const reader = new FileReader();
            reader.onload = function(event) {
                const newSheet = {
                    id: sheetMusicData.length + 1,
                    title: title,
                    price: parseInt(price),
                    image: event.target.result,
                    sheetMusic: URL.createObjectURL(sheetMusic)
                };

                sheetMusicData.push(newSheet);
                saveSheetMusicData();
                displaySheetMusic();
                showShopPage();
                alert('악보가 성공적으로 업로드되었습니다.');
            };
            reader.readAsDataURL(image);
        });

        function saveSheetMusicData() {
            localStorage.setItem('sheetMusicData', JSON.stringify(sheetMusicData));
        }

        function loadSheetMusicData() {
            const savedData = localStorage.getItem('sheetMusicData');
            if (savedData) {
                sheetMusicData = JSON.parse(savedData);
            }
        }

        loadSheetMusicData();
        displaySheetMusic();
    </script>
</body>
</html>